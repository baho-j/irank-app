# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Client (NEXT_PUBLIC_* is inlined into the browser bundle — no secrets here)
# ---------------------------------------------------------------------------

# Convex deployment URL. Also derives the allowed remote image host in
# next.config.mjs. The app throws a clear error at startup without it.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Web Push public key (public by design; the private key lives in Convex).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server — set via `npx convex env set <NAME> <value>`, not in this file.
# ---------------------------------------------------------------------------

# Base URL used to build shareable report links.
# FRONTEND_SITE_URL=https://your-app.vercel.app

# Google Gemini. Must stay server-side: a NEXT_PUBLIC_ key is extractable
# from the browser bundle and billable by anyone.
# GEMINI_API_KEY=

# Web Push private key, paired with NEXT_PUBLIC_VAPID_PUBLIC_KEY above.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org

# Email transport. Provider still being selected — see specs/01b-email.md.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
